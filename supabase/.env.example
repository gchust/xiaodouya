# 复制成 supabase/.env，填好后执行 supabase secrets set --env-file supabase/.env。
# 这个文件不会被提交。名字不能以 SUPABASE_ 开头，那是 Supabase 保留的。说明见 docs/DEPLOYMENT.md。

# 事务模式连接池（端口 6543），从控制台的 Connect 对话框复制完整地址，主机名不能自己拼。
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@YOUR-POOLER-HOST.pooler.supabase.com:6543/postgres
# openssl rand -base64 32
APP_SECRET=
ALLOW_SIGNUP=true

S3_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=xiaodouya
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# 托管模式：普通用户不用也不能填 S3 密钥。已经在用自己存储的家庭不受影响。
ALLOW_CUSTOM_STORAGE=false
# 下面都是默认值，写出来方便调整。依据见 docs/CAPACITY.md。
FAMILY_QUOTA_MB=102400
MAX_VIDEO_MB=1024
# 取客户端地址的请求头。上线前按 docs/DEPLOYMENT.md 确认这一项真的取到了客户端地址。
CLIENT_IP_HEADER=x-forwarded-for
CLIENT_IP_POSITION=last

# 自助找回密码和邮箱验证（可选）。留空表示不发邮件。函数上不能用 log，会拒绝启动。
MAIL_PROVIDER=
RESEND_API_KEY=
# 例如：小豆芽 <no-reply@baby.example.com>，发件域名要先在 Resend 验证
MAIL_FROM=

# 反馈问题（可选），见 docs/DEPLOYMENT.md“用户反馈”。两项都留空就不开；只填一项函数会拒绝启动。
# 仓库写成 owner/name。令牌用 fine-grained token：只选这一个仓库，权限只给 Issues: Read and write。
FEEDBACK_GITHUB_REPO=
FEEDBACK_GITHUB_TOKEN=
# 仓库是私有的才改成 false：App 据此提醒用户“文字会公开”。
FEEDBACK_REPO_PUBLIC=true
# 附件在 issue 建好后保留多少天，0 表示一直保留。定时清理（maintenance.yml）要设成一样。
FEEDBACK_ATTACHMENT_DAYS=90
# 能在 App 的「收到的反馈」里看反馈和附件的账号邮箱，逗号分隔，留空就没有这个入口。
# 先用这个邮箱注册好账号再填：没配邮件的服务器验证不了邮箱，别人可能抢先用它注册。
FEEDBACK_VIEWER_EMAILS=
