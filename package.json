{
  "name": "xiaodouya",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm --filter @xiaodouya/shared test && pnpm --filter @xiaodouya/mobile test",
    "test:server": "pnpm --filter @xiaodouya/server test",
    "dev:infra": "docker compose -f deploy/docker-compose.dev.yml up -d --wait && pnpm --filter @xiaodouya/server dev:bucket",
    "dev:server": "pnpm --filter @xiaodouya/server dev",
    "dev:mobile": "pnpm --filter @xiaodouya/mobile start",
    "android:build": "bash scripts/android-build.sh",
    "emulator": "bash scripts/emulator.sh",
    "screenshot": "bash scripts/screenshot.sh",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "~5.9.2"
  }
}
