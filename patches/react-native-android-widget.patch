+    /** Deletes old main images, keeping {@code current} and the {@code keepPrevious} newest others. */
+    static void deleteMainImagesExcept(Context context, int widgetId, String mode, String current, int keepPrevious) {
+        String prefix = "widget_" + widgetId + "_mode_" + mode;
+        File[] files = getFolderWithImages(context).listFiles(file ->
+            !file.getName().equals(current)
+                && (file.getName().equals(prefix + ".png")
+                    || (file.getName().startsWith(prefix + "_")
+                        && !file.getName().startsWith(prefix + "_collection_")))
+        );
+        if (files == null) {
+            return;
+        }
+        java.util.Arrays.sort(files, (a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        for (int i = keepPrevious; i < files.length; i++) {
+            files[i].delete();
+        }
+    }
+
