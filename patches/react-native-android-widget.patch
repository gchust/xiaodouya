index 0000000000000000000000000000000000000000..531e65b91ccca3ee1f824a81211e87079a9d135d
--- /dev/null
+++ b/android/src/main/java/com/reactnativeandroidwidget/builder/ClockView.java
@@ -0,0 +1,35 @@
+package com.reactnativeandroidwidget.builder;
+
+import android.widget.TextView;
+
+import com.facebook.react.bridge.ReadableMap;
+
+/**
+ * xiaodouya: a text the launcher keeps up to date by itself. The widget is a bitmap that is
+ * redrawn at most every 30 minutes, so "time since the last feed" cannot be drawn into it.
+ * The text view only reserves the place (it is not drawn); a TextClock is put over it. With the
+ * time zone set to minus the event's UTC time of day, the "clock" reads the elapsed time.
+ */
+public class ClockView {
+    private final TextView view;
+    private final String timeZone;
+    private final String format;
+
+    public ClockView(TextView view, ReadableMap clock) {
+        this.view = view;
+        this.timeZone = clock.getString("timeZone");
+        this.format = clock.getString("format");
+    }
+
+    public TextView getView() {
+        return view;
+    }
+
+    public String getTimeZone() {
+        return timeZone;
+    }
+
+    public String getFormat() {
+        return format;
+    }
+}
