# 复制成 .env 用于本地开发。所有参数的说明见 docs/DEPLOYMENT.md。
DATABASE_URL=postgres://xiaodouya:devpassword@localhost:55432/xiaodouya
APP_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZA==
PORT=8787
# 服务端对外的地址。反馈附件的公开链接用它拼，不设时附件不公开，见 docs/DEPLOYMENT.md 的用户反馈。
PUBLIC_API_URL=http://localhost:8787
ALLOW_SIGNUP=true
S3_ENDPOINT=http://localhost:59000
# 模拟器访问宿主机要用 10.0.2.2；真机调试改成电脑的局域网 IP。
S3_PUBLIC_ENDPOINT=http://10.0.2.2:59000
S3_REGION=us-east-1
S3_BUCKET=xiaodouya-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
# 开发和 E2E（流程 07）要覆盖自定义存储表单。不写的话，配了上面的 S3 就是托管模式，表单不显示。
ALLOW_CUSTOM_STORAGE=true
ALLOW_PRIVATE_STORAGE_ENDPOINTS=true
# 本地调试验证码时打开，验证码会打到服务端终端。保持注释：CI 的 E2E 直接用这个文件，
# 打开就会多出一步邮箱验证，所有流程都会失败。resend 还需要 RESEND_API_KEY 和 MAIL_FROM。
# MAIL_PROVIDER=log
