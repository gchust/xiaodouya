{
  "name": "@xiaodouya/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:bucket": "tsx --env-file-if-exists=.env src/dev-bucket.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@hono/node-server": "^1.19.0",
    "@xiaodouya/shared": "workspace:*",
    "hono": "^4.13.14",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
