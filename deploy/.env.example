# 复制成 deploy/.env。每个参数的说明见 docs/DEPLOYMENT.md。

# 必填：解析到这台服务器的域名
DOMAIN=baby.example.com
# 必填：填 openssl rand -hex 24 的输出（只用十六进制，避免特殊字符破坏连接串）
# 这个文件不会执行命令，不要把 $(openssl ...) 原样写进来
POSTGRES_PASSWORD=
# 必填：填 openssl rand -base64 32 的输出。用来加密存储密钥，丢失或更换后已保存的存储配置将无法解密
APP_SECRET=

# 全家都注册后建议改成 false，之后只能凭邀请码注册
ALLOW_SIGNUP=true
MAX_UPLOAD_MB=4096
MAX_VIDEO_MB=4096
# 每个家庭在默认存储上的配额，0 表示不限。自建默认不限，开放给别人用时再设置。
FAMILY_QUOTA_MB=0

# 默认存储（可选）。也可以留空，由管理员在 App 的「家人 → 存储」里配置。
# Cloudflare R2 示例：
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=xiaodouya
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# 让管理员在 App 里填自己的 S3。开放给陌生人用时改成 false，只用上面的默认存储。
ALLOW_CUSTOM_STORAGE=true
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false

# 家人记录时的远程推送（可选，需要 FCM，见部署文档）
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# 自助找回密码和邮箱验证（可选）。留空表示不发邮件：跳过邮箱验证，忘记密码由部署者重置。
# resend：Resend 的 HTTPS API，发件域名要先在 Resend 验证。log 只能本地开发用，这里会拒绝启动。
MAIL_PROVIDER=
RESEND_API_KEY=
# 例如：小豆芽 <no-reply@baby.example.com>
MAIL_FROM=
