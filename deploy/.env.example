# 复制成 deploy/.env。每个参数的说明见 docs/DEPLOYMENT.md。

# 必填：解析到这台服务器的域名
DOMAIN=baby.example.com
# 必填：openssl rand -hex 24（只用十六进制，避免特殊字符破坏连接串）
POSTGRES_PASSWORD=
# 必填：openssl rand -base64 32。用来加密存储密钥，丢失或更换后已保存的存储配置将无法解密
APP_SECRET=

# 全家都注册后建议改成 false，之后只能凭邀请码注册
ALLOW_SIGNUP=true
MAX_UPLOAD_MB=4096

# 默认存储（可选）。也可以留空，由管理员在 App 的「家人 → 存储」里配置。
# Cloudflare R2 示例：
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=xiaodouya
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

ALLOW_CUSTOM_STORAGE=true
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false

# 家人记录时的远程推送（可选，需要 FCM，见部署文档）
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
